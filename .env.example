ADMIN_EMAIL=linuzvisionllc@gmail.com
ADMIN_NAME=LinuZvision Administrator
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
GOOGLE_SITE_VERIFICATION=replace-with-google-search-console-token
DATABASE_DIRECTORY=/absolute/path/to/persistent-volume
