ADMIN_EMAIL=linuzvisionllc@gmail.com
ADMIN_NAME=LinuZvision Administrator
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
GOOGLE_SITE_VERIFICATION=replace-with-google-search-console-token
DATABASE_DIRECTORY=/absolute/path/to/persistent-volume
# Initial WhatsApp number (digits only, e.g. 14435550100). The dashboard (Coordonnées) overrides it once saved.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Number of reverse proxies in front of the app that append to X-Forwarded-For (rate limiting).
TRUSTED_PROXY_HOPS=1
# Folder for files sent from the dashboard (course videos, images, portraits). Must be a persistent
# volume that survives redeployments. Defaults to "<DATABASE_DIRECTORY>/uploads".
UPLOADS_DIRECTORY=/absolute/path/to/persistent-volume/uploads
